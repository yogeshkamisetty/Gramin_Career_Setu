# ==============================================================================
# Gramin Career Setu - Environment Variables Template
# Copy this file to .env and configure values before starting containers
# ==============================================================================

# Application Profile: 'dev' (H2 in-memory), 'docker' (local docker-compose), 'prod' (production)
SPRING_PROFILES_ACTIVE=docker

# Port Bindings
PORT=8085
BACKEND_PORT=8085
NODE_PORT=5000

# PostgreSQL Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=gramin_career_setu
DATABASE_USER=gcs_admin
DATABASE_PASSWORD=gcs_production_secure_password_replace_me
DATABASE_SSL_MODE=prefer

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=gcs_redis_secure_password_replace_me
REDIS_SSL=false

# Managed OIDC / OAuth2 Authentication (Keycloak, Auth0, Azure AD B2C)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=gcs_keycloak_admin_password_replace_me
KEYCLOAK_PORT=8081
OIDC_ISSUER_URI=http://keycloak:8080/realms/gramin-career-setu
JWK_SET_URI=http://keycloak:8080/realms/gramin-career-setu/protocol/openid-connect/certs

# Connection Pool Tuning (HikariCP)
HIKARI_MAX_POOL=25
HIKARI_MIN_IDLE=5
