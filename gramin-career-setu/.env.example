# ==============================================================================
# Gramin Career Setu - Environment Variables Template
# Copy this file to .env and configure values before starting containers
# ==============================================================================

# Application Profile: 'mysql' (Local Native MySQL 8.0), 'dev' (H2 in-memory), 'docker' (Docker Compose)
SPRING_PROFILES_ACTIVE=dev

# Port Bindings
PORT=8085
BACKEND_PORT=8085
NODE_PORT=5000

# Local Native MySQL Configuration (used with SPRING_PROFILES_ACTIVE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gramin_career_setu
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password_here

# PostgreSQL Database Configuration (used with docker/prod)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=gramin_career_setu
DATABASE_USER=gcs_admin
DATABASE_PASSWORD=gcs_production_secure_password_replace_me
DATABASE_SSL_MODE=prefer

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=gcs_redis_secure_password_replace_me
REDIS_SSL=false

# Managed OIDC / OAuth2 Authentication (Keycloak, Auth0, Azure AD B2C)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=gcs_keycloak_admin_password_replace_me
KEYCLOAK_PORT=8081
OIDC_ISSUER_URI=http://keycloak:8080/realms/gramin-career-setu
JWK_SET_URI=http://keycloak:8080/realms/gramin-career-setu/protocol/openid-connect/certs

# Connection Pool Tuning (HikariCP)
HIKARI_MAX_POOL=25
HIKARI_MIN_IDLE=5

# JWT signing secret for the backend's own tokens.
# REQUIRED before any real deployment. At least 32 characters.
# If unset, the backend generates a random key at startup and logs a warning:
# sessions then stop working whenever it restarts.
# Generate one with:  openssl rand -base64 48
APP_JWT_SECRET=replace_me_with_a_long_random_string
APP_JWT_EXPIRATION_MS=86400000
